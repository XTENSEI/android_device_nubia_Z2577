# Recovery init for Nubia V80 Max (Z2577) - ro.hardware=ums9230_6h10
import /init.recovery.common.rc

# FBE decrypt: prepdecrypt sets crypto.ready; the SPRD boot HAL below provides
# android.hardware.boot@1.0, which recovery waits on before decrypt
on fs
    start prepdecrypt

service prepdecrypt /system/bin/prepdecrypt.sh
    oneshot
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

service keymint-2-0 /system/bin/android.hardware.security.keymint@2.0-unisoc.service.trusty
    interface aidl android.hardware.security.keymint.IKeyMintDevice/default
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service.trusty
    interface hidl android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# stock vendor rc, class hal because recovery never class_starts early_hal
service vendor.sprd.boot-hal-1-2 /vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service
    class hal
    user root
    group root
    seclabel u:r:recovery:s0

# TEE TA supplier, stock class core service that recovery has to start itself
service vendor.tsupplicant /vendor/bin/tsupplicant odm/firmware odm/firmware/fingerprint vendor/firmware
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

service ta-supplier-wait /system/bin/start_tsupplicant.sh
    oneshot
    disabled
    user root
    group root
    seclabel u:r:recovery:s0

# TEE secure-storage proxies (stock storageproxyd_android.rc, class core in
# normal boot): the gatekeeper TA reads its failure records through them, and
# verify dies with ERROR_UNKNOWN when the ss server has no proxy. Stock start
# order is rpmb first, then ns.
service vendor.rpmbproxy /vendor/bin/sprdstorageproxyd -f rpmb -d /dev/trusty-ipc-dev0 -p /data/vendor/sprd_ss
    user root
    group system
    oneshot
    disabled
    seclabel u:r:recovery:s0

service vendor.nsproxy /vendor/bin/sprdstorageproxyd -f ns -d /dev/trusty-ipc-dev0 -p /data/vendor/sprd_ss
    user root
    group system
    disabled
    seclabel u:r:recovery:s0

service vendor.prodproxy /vendor/bin/sprdstorageproxyd -f prodnv -d /dev/trusty-ipc-dev0 -p /mnt/vendor/productinfo/sprd_ss
    user root
    group system
    oneshot
    disabled
    seclabel u:r:recovery:s0

on property:crypto.ready=1
    mkdir /data/vendor/sprd_ss 0770 system system
    mkdir /mnt/vendor 0755 system system
    mount ext4 /dev/block/by-name/prodnv /mnt/vendor noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc
    mkdir /mnt/vendor/productinfo/sprd_ss 0770 system system
    start vendor.rpmbproxy
    start vendor.nsproxy
    start vendor.prodproxy
    start keymint-2-0
    start ta-supplier-wait

on property:vendor.sprd.tsupplicant.enabled=1
    start vendor.tsupplicant

# only once the supplier is up, the TEE asks it for the TA on connect
on property:twrp.tsupplicant.ready=1
    start gatekeeper-1-0

on property:ro.crypto.state=unsupported || property:ro.crypto.state=unencrypted || property:twrp.decrypt.done=true
    stop keymint-2-0
    stop gatekeeper-1-0

on boot
    start health-hal-2-1
